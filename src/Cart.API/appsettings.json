{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=cart.db;Foreign Keys=True;"
  },
  "Services": {
    "ProductsApiUrl": "http://localhost:5110"
  },
  "AllowedHosts": "*",
  "Observability": {
    "MinimumLevel": "Information",
    "LogPath": "logs/audit-.jsonl"
  },
  "Swagger": {
    "Enabled": true
  }
}
